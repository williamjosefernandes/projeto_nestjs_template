# Database
DATABASE_URL="postgresql://user:password@localhost:5432/db_name?schema=public"

# JWT Auth
JWT_SECRET="replace-with-a-strong-random-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-strong-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5371"
CORS_ORIGINS=""

# SMTP Email Configuration
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Your App <your-email@example.com>"

# Firebase Admin SDK — JSON completo da service account, em base64 (nunca commitar o valor real)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
FIREBASE_SERVICE_ACCOUNT_BASE64="base64-encoded-service-account-json"
